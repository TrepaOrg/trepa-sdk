{
	"name": "@trepa/sdk-examples",
	"private": true,
	"version": "0.0.0",
	"description": "TypeScript examples for the Trepa API, built on @trepa/sdk.",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"example": "tsx",
		"example:session": "tsx src/examples/01-session.ts",
		"example:find-pool": "tsx src/examples/02-find-pool.ts",
		"example:place-prediction": "tsx src/examples/03-place-prediction.ts",
		"example:update-prediction": "tsx src/examples/04-update-prediction.ts",
		"example:update-stake": "tsx src/examples/05-update-stake.ts",
		"example:streak-progress": "tsx src/examples/06-streak-progress.ts",
		"example:claim-streak-reward": "tsx src/examples/07-claim-streak-reward.ts",
		"example:claim-pool-reward": "tsx src/examples/08-claim-pool-reward.ts",
		"example:withdraw": "tsx src/examples/09-withdraw.ts",
		"example:quickstart": "tsx src/examples/quickstart.ts"
	},
	"dependencies": {
		"@solana/web3.js": "^1.98.4",
		"@trepa/sdk": "workspace:*",
		"dotenv": "^17.4.2"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"tsx": "^4.21.0",
		"typescript": "^5.6.0"
	}
}
