# Get this from Settings -> API keys in the Trepa app.
TREPA_API_KEY=trp_your_64_hex_chars_here

# Export your embedded wallet private key from Settings -> Embedded Wallet
# in the Trepa app. Treat as a secret. Never commit this file with real keys.
TREPA_PRIVATE_KEY=your_base58_private_key_here

# Optional. Defaults to the production API.
TREPA_API_URL=https://www.api.trepa.app

# Optional. The streak slug used by examples that need a streak. Defaults to bitcoin.
TREPA_STREAK_SLUG=bitcoin
