{
  "name": "@trepa/sdk",
  "version": "0.3.19",
  "packageManager": "pnpm@11.17.0",
  "description": "Typed TypeScript SDK for the Trepa API",
  "keywords": [
    "typescript",
    "sdk",
    "openapi",
    "solana",
    "trepa"
  ],
  "homepage": "https://github.com/TrepaOrg/trepa-sdk#readme",
  "documentation": "https://docs.trepa.io/developers/introduction",
  "bugs": {
    "url": "https://github.com/TrepaOrg/trepa-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TrepaOrg/trepa-sdk.git"
  },
  "license": "MIT",
  "author": "Trepa <leon@trepa.io> (https://trepa.io)",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js",
      "require": "./dist/schema.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "gen": "node scripts/gen.mjs",
    "build": "tsup",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0 --fix",
    "format": "eslint . --fix --ignore-pattern pnpm-lock.yaml --ignore-pattern '*.json' && prettier --write .",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@solana-program/system": "0.13.0",
    "@solana-program/token": "0.15.0",
    "@solana/addresses": "8.2.0",
    "@solana/keys": "8.2.0",
    "@solana/kit": "8.2.0",
    "@solana/rpc": "8.2.0",
    "@solana/rpc-parsed-types": "8.2.0",
    "@solana/rpc-subscriptions": "8.2.0",
    "@solana/rpc-types": "8.2.0",
    "@solana/transaction-confirmation": "8.2.0",
    "@solana/transactions": "8.2.0",
    "ink": "7.1.1",
    "ink-spinner": "5.0.0",
    "openapi-fetch": "0.17.0",
    "react": "19.2.8"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.0",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "8.65.0",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.6",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.6",
    "tsup": "8.5.1",
    "typescript": "6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
