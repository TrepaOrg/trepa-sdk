{
	"name": "trepa-examples-root",
	"private": true,
	"version": "0.0.0",
	"description": "Workspace root for the Trepa examples and SDK.",
	"license": "MIT",
	"engines": {
		"node": ">=20",
		"pnpm": ">=10"
	},
	"scripts": {
		"gen": "pnpm --filter @trepa/sdk gen",
		"build": "pnpm --filter @trepa/sdk build",
		"typecheck": "pnpm -r typecheck",
		"clean": "pnpm -r exec rm -rf dist .tsbuildinfo node_modules/.cache"
	}
}
